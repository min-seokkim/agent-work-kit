{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v awkit >/dev/null 2>&1; then cd \"$CLAUDE_PROJECT_DIR\" && awkit check done --hook; fi"
          }
        ]
      }
    ]
  }
}
